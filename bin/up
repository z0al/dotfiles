#!/bin/sh

# Usage:
# Switches to the configuration using the default host name:
# $ up
#
# Switches to the configuration for "myhost":
# $ up -t myhost
#
# Use a different dotfiles directory (default is the current directory):
# $ up -f /path/to/dotfiles
#
# Reclaim disk space:
# $ up clean
#
# Launch a NixOS VM:
# $ up vm
#
# Any other subcommand (build, boot, ...) is passed straight through to
# nixos-rebuild/darwin-rebuild. Unknown flags are passed down too, so to
# build without switching, or to update flake inputs first, use:
# $ up build
# $ up -u

set -e

nix() {
  command nix --extra-experimental-features 'nix-command flakes' --accept-flake-config "$@"
}

platform() {
  if [ "$(uname)" = Darwin ]; then
    echo darwin
  elif [ -e /etc/NIXOS ]; then
    echo os
  else
    echo home
  fi
}

flake=$(pwd)
target=
update=

while [ $# -gt 0 ]; do
  case $1 in
    -t | --target) target=$2; shift 2 ;;
    -f | --flake) flake=$2; shift 2 ;;
    -u | --update) update=1; shift ;;
    -h | --help)
      cat <<EOF
Apply flake-based system configuration using Nix

Usage: up [options] [command]

Options:
  -t, --target name    Target flake configuration
  -f, --flake PATH     Use the flake at PATH
  -u, --update         Update flake inputs first
  -h, --help           Show help

Commands:
  clean                Reclaim disk space
  vm                   Launch a NixOS VM
  <anything else>      Passed through to nixos-rebuild/darwin-rebuild (default: switch)

Note: unknown flags are passed down to the underlying command
EOF
      exit 0
      ;;
    *) break ;;
  esac
done

cmd=switch
case ${1-} in
  '' | -*) ;;
  *) cmd=$1; shift ;;
esac

if [ -n "$update" ]; then
  nix flake update --flake "$flake"
fi

case $cmd in
  clean)
    if [ "$(platform)" = home ]; then
      nix-collect-garbage -d "$@"
    else
      sudo nix-collect-garbage -d "$@"
    fi
    ;;

  vm)
    nix run "$flake#vm" "$@"
    ;;

  *)
    ref=$flake${target:+#$target}

    case $(platform) in
      darwin) sudo darwin-rebuild "$cmd" --flake "$ref" --option accept-flake-config true "$@" ;;
      os) sudo nixos-rebuild "$cmd" --flake "$ref" --option accept-flake-config true "$@" ;;
      home)
        out=$(nix build "$flake#homeConfigurations.${target:-$(hostname)}.activationPackage" --no-link --print-out-paths "$@")
        [ "$cmd" = build ] || "$out/activate"
        ;;
    esac
    ;;
esac
