#!/usr/bin/env fish

# Usage:
# Switches to the configuration using the default host name:
# $ up
#
# Switches to the configuration for "myhost":
# $ up -t myhost
#
# Use a different dotfiles directory (default is the current directory):
# $ up -f /path/to/dotfiles
#
# Reclaim disk space:
# $ up clean
#
# Launch a NixOS VM:
# $ up vm
#
# Any other subcommand (build, boot, ...) is passed straight through to
# nixos-rebuild/darwin-rebuild. Unknown flags are passed down too, so to
# build without switching, or to update flake inputs first, use:
# $ up build
# $ up -u

function nix
    command nix --experimental-features 'nix-command flakes' --accept-flake-config $argv
end

function platform
    if test (uname) = Darwin
        echo darwin
    else if test -e /etc/NIXOS
        echo os
    else
        echo home
    end
end

function up
    argparse -i -n up --stop-nonopt 't/target=' 'f/flake=' u/update h/help -- $argv
    or return

    if set -q _flag_help
        echo "Apply flake-based system configuration using Nix"
        echo ""
        echo "Usage: up [options] [command]"
        echo ""
        echo "Options:"
        echo "  -t, --target name    Target flake configuration"
        echo "  -f, --flake PATH     Use the flake at PATH"
        echo "  -u, --update         Update flake inputs first"
        echo "  -h, --help           Show help"
        echo ""
        echo "Commands:"
        echo "  clean                Reclaim disk space"
        echo "  vm                   Launch a NixOS VM"
        echo "  <anything else>      Passed through to nixos-rebuild/darwin-rebuild (default: switch)"
        echo ""
        echo "Note: unknown flags are passed down to the underlying command"
        return 0
    end

    set -q _flag_flake || set _flag_flake $(pwd)

    set -l cmd switch
    set -l args $argv
    if test (count $argv) -gt 0; and not string match -q -- '-*' $argv[1]
        set cmd $argv[1]
        set args $argv[2..-1]
    end

    set -q _flag_update; and nix flake update --flake $_flag_flake

    switch $cmd
        case clean
            if test (platform) = home
                nix-collect-garbage -d $args
            else
                sudo nix-collect-garbage -d $args
            end

        case vm
            nix run "$_flag_flake#vm" $args

        case '*'
            set -l ref $_flag_flake
            test -n "$_flag_target"; and set ref "$ref#$_flag_target"

            switch (platform)
                case darwin
                    sudo darwin-rebuild $cmd --flake $ref --option accept-flake-config true $args
                case os
                    sudo nixos-rebuild $cmd --flake $ref --option accept-flake-config true $args
                case home
                    set -l target $_flag_target
                    test -n "$target"; or set target (hostname)
                    set -l out (nix build "$_flag_flake#homeConfigurations.$target.activationPackage" --no-link --print-out-paths $args)
                    or return
                    test $cmd = build; or $out/activate
            end
    end
end

up $argv
