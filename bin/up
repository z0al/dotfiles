#!/usr/bin/env fish

# Usage:
# Switches to the configuration using the default host name:
# $ up
#
# Switches to the configuration for "myhost":
# $ up -h myhost
#
# Use a different dotfiles directory (default is ~/.dotfiles):
# $ up -d /path/to/dotfiles
#
# Reclaim disk space:
# $ up clean
#
# Launch a NixOS VM:
# $ up vm
#
# Any other subcommand (build, boot, repl, rollback, ...) is passed straight
# through to `nh os`/`nh darwin`. Unknown flags are passed down too, so to
# build without switching, or to update flake inputs, use:
# $ up build
# $ up -u

function nix
    command nix --experimental-features 'nix-command flakes' $argv
end

# nh (https://github.com/nix-community/nh) handles its own privilege
# elevation, so it must not be prefixed with sudo.
function rebuild
    switch (uname)
        case Darwin
            nh darwin $argv -- --accept-flake-config
        case '*'
            nh os $argv -- --accept-flake-config
    end
end

function up
    # -i ignores unknown flags, --stop-nonopt stops parsing at the
    # subcommand, so both pass through untouched to the underlying command
    # (e.g. `up switch --help` forwards --help to nh instead of us).
    argparse -i -n up --stop-nonopt 't/target=' 'f/flake=' h/help -- $argv
    or return

    # Default flake path to $(pwd)
    set -q _flag_flake || set _flag_flake $(pwd)

    # nh expects a FLAKEREF[#ATTRPATH] installable. If the target is empty,
    # nh takes the current hostname.
    set -l flake "$_flag_flake#$_flag_target"

    if set -q _flag_help
        echo "Apply flake-based system configuration using Nix"
        echo ""
        echo "Usage: up [options] [command]"
        echo ""
        echo "Options:"
        echo "  -t, --target name    Target flake configuration"
        echo "  -f, --flake PATH     Use the flake at PATH"
        echo "  -h, --help           Show help"
        echo ""
        echo "Commands:"
        echo "  clean                Reclaim disk space"
        echo "  vm                   Launch a NixOS VM"
        echo "  <anything else>      Passed through to nh os/nh darwin (default: switch)"
        echo ""
        echo "Note: unknown flags are passed down to the underlying command"
        return 0
    end

    switch $argv[1]
        case clean
            nh clean all $argv[2..-1]

        case vm
            nix run "$_flag_flake#vm" $argv[2..-1]

        case '' '-*'
            # No subcommand, just flags (e.g. `up -u`)
            rebuild switch $flake $argv

        case '*'
            rebuild $argv[1] $flake $argv[2..-1]
    end
end

up $argv
